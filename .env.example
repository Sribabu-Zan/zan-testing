# Key NAMES only. Copy to .env.local and fill in.
# Everything the chat backend, the agent console and the WhatsApp bridge need.

# Database
MONGODB_URI=

# Auth — signs agent sessions and per-conversation chat tokens
JWT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Pusher — NEXT_PUBLIC_* are exposed to the browser and are not secrets
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
WHATSAPP_LEAD_TEMPLATE=
WHATSAPP_TEMPLATE_LOCALE=
WHATSAPP_DRY_RUN=

# Logging
LOG_LEVEL=
